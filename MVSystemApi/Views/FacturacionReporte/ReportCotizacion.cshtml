@model MVSystemApi.Model.CotizacionModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Cotización</title>

    <style>
        .p0 p {
            padding: 0%;
            margin: 0%;
        }
    </style>
</head>

<body>
    <div class="container text-center">
        <img src="@Model.DatosEmpresaCotizacion.Logo" alt="Logo Empresa" />
    </div>

    <div class="container text-center p0 mb-3">
        <p>@Model.DatosEmpresaCotizacion?.Encabezado</p>
        <p>@Model.DatosEmpresaCotizacion?.Direccion</p>
        <p>@Model.DatosEmpresaCotizacion?.Telefonos</p>
        <p> <b> RNC: @Model.DatosEmpresaCotizacion?.RNC </b> </p>
    </div>

    <div class="container border border-dark">
        <div class="row">
            <div class="col-6 border border-dark">
                <b>Cliente</b><br>
                <b>Código: </b>@Model.IdCliente<br>
                <b>Nombre: </b>@Model.Nombre @Model.Apellido<br>
                <b>Teléfono: </b>@Model.Telefono<br>
                <b>Vendedor: </b>@Model.Vendedor<br>
            </div>

            <div class="col-6 border border-dark">
                <b>Fecha: </b> @Model.FechaFacturacion<br>
                <b>RNC/Cédula: </b>@Model.Rnc
            </div>
        </div>
    </div>

    <div class="container ">
        <div class="row text-center mt-4 mb-3">
            <b>
               COTIZACIÓN
            </b>
        </div>

        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">COD.</th>
                        <th scope="col">DESCRIPCIÓN</th>
                        <th scope="col">CANT.</th>
                        <th scope="col">PRECIO</th>
                        <th scope="col">SUBTOTAL</th>
                        <th scope="col">DESC</th>
                        <th scope="col">TOTAL</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        foreach (var item in Model.Articulos)
                        {
                            <tr>
                                <td>@item.IdEquipo</td>
                                <td>@item.Descripcion</td>
                                <td>@item.Cantidad.ToString("N0")</td>
                                <td>@item.Precio.ToString("N2")</td>
                                <td>@item.SubTotal.ToString("N2")</td>
                                <td>@item.Descuento.ToString("N2")</td>
                                <td>@item.Total.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="container text-right">
        <div>Subtotal: <b>@Model.SubTotal.ToString("N2")</b></div>
        <div>Descuento:<b>@Model.Descuento.ToString("N2")</b></div>
        <div>ITBIS:    <b>@Model.Itbis.ToString("N2")</b></div>
        <div>Total:    <b>@Model.Total.ToString("N2")</b></div>
    </div>

    <div class="container">
        <div class="row">
            <p>Nota:</p>
        </div>

        <div class="row">
            <p>
                <b>NOTA: </b>
                @Model.Nota
            </p>
        </div>
    </div>

    <br />
    <br />

    <div class="container">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Entregado por</b>
            </div>

            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>

    <div class="container">
        <div class=" text-right">
            Fecha de Impresión: @DateTime.Now
        </div>
    </div>
</body>

</html>