@using MVSystemApi.Model
@model EmpresaReportes

@{
    Layout = null;
    var recibo = Model.ReciboAbonoGeneral.FirstOrDefault();
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Recibo de Abono General</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            width: 80mm;
            max-width: 80mm;
            margin: 0;
            font-size: 10pt;
            background: #fff;
            overflow-x: hidden;
        }

        .container.text-center p {
            margin-top: 2px;
            margin-bottom: 2px;
        }

        .container {
            width: 100%;
            max-width: 80mm;
            padding: 0 4px;
        }

        /* Neutraliza los márgenes negativos del grid de Bootstrap, que de
           lo contrario harían que el contenido se saliera de los 80mm. */
        .row {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .row > [class^="col-"],
        .row > [class*=" col-"] {
            padding-left: 2px !important;
            padding-right: 2px !important;
        }

        table {
            width: 100% !important;
            max-width: 100%;
            table-layout: fixed;
        }

        th, td {
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .logo {
            display: block;
            margin: 0 auto 8px auto;
            max-width: 120px;
        }

        .section-title {
            font-size: 1.1em;
            font-weight: bold;
            margin: 10px 0 6px 0;
            text-align: center;
            letter-spacing: 1px;
        }

        .table th, .table td {
            padding: 2px 6px;
        }

        .total-row td {
            font-weight: bold;
            font-size: 1.05em;
            border-top: 2px solid #000;
        }

        .saldada {
            font-weight: bold;
        }

        /* Tabla de facturas: 5 columnas, requiere fuente/padding reducidos y
           anchos fijos para no exceder los 80mm de la impresora térmica. */
        .tabla-facturas th, .tabla-facturas td {
            padding: 2px 3px;
            font-size: 7.5pt;
            text-align: center;
        }

        @@media print {
            html, body { margin: 0; width: 80mm; max-width: 80mm; }
            .no-print { display: none; }
        }

        body, table, th, td, p, span, b {
            color: #000 !important;
            opacity: 1 !important;
            font-family: Arial, Helvetica, sans-serif !important;
        }

        @@media print {
            body, table, th, td, p, span, b {
                color: #000 !important;
                opacity: 1 !important;
                -webkit-print-color-adjust: exact;
                print-color-adjust: exact;
            }
        }
    </style>
</head>
<body>
    <img src="@recibo.Logo" alt="Logo" class="logo" />

    <div class="container text-center p0 mb-1">
        <p>@Model.DatosEmpresaFactura.Encabezado</p>
        <p>@Model.DatosEmpresaFactura.Direccion</p>
        <p>@Model.DatosEmpresaFactura.Telefonos</p>
        <p><b>RNC: @Model.DatosEmpresaFactura.RNC</b></p>
    </div>

    <div class="section-title">*** RECIBO DE ABONO GENERAL ***</div>

    <div class="container border border-dark mb-2">
        <div class="text-center">
            <b>Cliente: </b>@recibo.NombreCliente @recibo.ApellidoCliente
        </div>
        <div class="text-center">
            <b>Fecha: </b>@recibo.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")
        </div>
    </div>

    <div class="container mb-2">
        <table class="table table-bordered table-sm tabla-facturas">
            <colgroup>
                <col style="width: 16%">
                <col style="width: 21%">
                <col style="width: 21%">
                <col style="width: 21%">
                <col style="width: 21%">
            </colgroup>
            <thead>
                <tr>
                    <th>Factura</th>
                    <th>Total</th>
                    <th>Abonado</th>
                    <th>Pendiente</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var factura in recibo.Facturas)
                {
                    <tr>
                        <td>@factura.NumeroFactura</td>
                        <td>@factura.TotalFactura.ToString("C")</td>
                        <td>@factura.TotalAbono.ToString("C")</td>
                        <td>@factura.Pendiente.ToString("C")</td>
                        <td class="@(factura.Saldada ? "saldada" : "")">
                            @(factura.Saldada ? "Saldada" : "Pendiente")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="container">
        <table class="table table-bordered table-sm">
            <tbody>
                <tr class="total-row">
                    <td>Total Abonado:</td>
                    <td>@recibo.TotalAbonado.ToString("C")</td>
                </tr>
                @if (!string.IsNullOrEmpty(recibo.TipoPago))
                {
                    <tr>
                        <th>Tipo de Pago:</th>
                        <td>@recibo.TipoPago</td>
                    </tr>
                }
                <tr>
                    <th>Atendido por:</th>
                    <td>@recibo.Usuario</td>
                </tr>
                @if (!string.IsNullOrEmpty(recibo.Nota))
                {
                    <tr>
                        <th>Nota:</th>
                        <td>@recibo.Nota</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="container mt-3">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Entregado por</b>
            </div>
            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>

    <div class="container text-right mt-2">
        <small>Impreso: @DateTime.Now.ToString("dd/MM/yyyy hh:mm tt")</small>
    </div>
</body>
</html>
