@model MVSystemApi.Model.Facturas

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Factura</title>

    <style>
        .p0 p {
            padding: 0;
            margin: 0;
        }

        /* Estilos personalizados para ajustar el ancho a 80mm */
        body {
            width: 80mm; /* Establece el ancho del cuerpo a 80mm */
            margin: 0; /* Sin márgenes adicionales */
            font-size: 10pt; /* Ajusta el tamaño de fuente si es necesario */
        }

        /* Ajustar las tablas para que se adapten al ancho de 80mm */
        .table {
            width: 100%;
            font-size: 10pt;
        }

        .container {
            width: 100%;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        /* Elimina márgenes y relleno para asegurarse que todo esté dentro del área de impresión */
        .p0 {
            padding: 0;
            margin: 0;
        }

        /* Bordes del contenedor */
        .border {
            border: 1px solid black;
        }

        .border-dark {
            border-color: black;
        }

        .mb-3 {
            margin-bottom: 1rem;
        }

        .mt-4 {
            margin-top: 1.5rem;
        }

        hr {
            border: 1px solid black;
        }
    </style>
</head>

<body>
    <div class="container text-center">
        <img src="@Model.Factura.logo" alt="Logo Empresa" style="max-width: 100%; height: auto;" />
    </div>

    <div class="container text-center p0 mb-3">
        <p>@Model.DatosEmpresaFactura.Encabezado</p>
        <p>@Model.DatosEmpresaFactura.Direccion</p>
        <p>@Model.DatosEmpresaFactura.Telefonos</p>
        <p> <b>RNC: @Model.DatosEmpresaFactura.RNC</b> </p>
    </div>

    <div class="container border border-dark">
        <div class="row">
            <div class="col-6 border border-dark">
                <p>
                    @{
                        if (Model.Factura.Rnc.Length > 0)
                        {
                            <b>RNC: </b> @Model.Factura.Rnc
                        }
                        else
                        {
                            <b>Cód: </b> @Model.Factura.ClienteId
                        }
                    }
                </p>
                <b>Cli: </b>@Model.Factura.Nombres @Model.Factura.Apellidos<br>
                <b>Tel: </b>@Model.Factura.Telefono<br>
                <b>Ven: </b>@Model.Factura.Vendedor<br>
            </div>

            <div class="col-6 border border-dark">
                <b>FT: P @Model.Factura.NumeroFactura</b><br>
                <b>TF: </b>@Model.Factura.TipoFactura<br>
                <b>TP: </b>@Model.Factura.TipoPago<br>
                <b>Fecha: </b>@Model.Factura.FechaFacturacion<br>
                <b>NCF: </b>@Model.Factura.Ncf
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row text-center mt-4 mb-3">
            <b>DETALLES DE FACTURA</b>
        </div>

        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        @*<th scope="col">COD.</th>*@
                        <th scope="col">DESCRIPCION</th>
                        <th scope="col">CANT.</th>
                        <th scope="col">PRECIO</th>
                       @* <th scope="col">SUB</th>
                        <th scope="col">DESC</th>*@
                        <th scope="col">TOTAL</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model.DetalleFacturaList)
                    {
                        <tr>
                            @*<td>@item.IdEquipo</td>*@
                            <td>@item.IdEquipo @item.Descripcion</td>
                            <td>@item.Cantidad.ToString("N0")</td>
                            <td>@item.Precio.ToString("N2")</td>
                          @*  <td>@item.SubTotal.ToString("N2")</td>
                            <td>@item.Descuento.ToString("N2")</td>*@
                            <td>@item.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="container text-right">
        <div>Subtotal: <b> @Model.Factura.SubTotal.ToString("N2")</b></div>
        <div>Descuento:<b> @Model.Factura.Descuento.ToString("N2")</b></div>
        <div>ITBIS:    <b> @Model.Factura.Itbis.ToString("N2")</b></div>
        <div>Abonado:  <b> @Model.Abono.ToString("N2")</b></div>
        <div>Total:    <b> @Model.Factura.Total.ToString("N2")</b></div>
    </div>

    <div class="container">
        <div class="row">
            <p>Nota: @Model.Factura.Nota</p>
        </div>

        <div class="row">
            <p>
                <b>GARANTIA: </b>
               @Model.DatosEmpresaFactura.CondicionesGarantia
            </p>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Entregado por</b>
            </div>

            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>

    <div class="container text-right">
        Fecha de Impresión: @DateTime.Now
    </div>
</body>


</html>