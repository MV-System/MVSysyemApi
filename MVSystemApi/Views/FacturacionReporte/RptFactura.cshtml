@model MVSystemApi.Model.FacturaCliente

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Factura</title>

    <style>
        .p0 p {
            padding: 0%;
            margin: 0%;
        }
    </style>
</head>

<body>
    <div class="container text-center">
        <img src="@Model.Factura.logo" alt="Logo" />
    </div>

    <div class="container text-center p0">
        <p>@Model.DatosEmpresaFactura.Encabezado</p>
        <p>@Model.DatosEmpresaFactura.Direccion </p>
        <p>@Model.DatosEmpresaFactura.Telefonos </p>
        <p>
            @{
                if (Model.Factura.RNC.Length > 0)
                {
                    <b>RNC: </b>  @Model.DatosEmpresaFactura.RNC;
                }
            }
        </p>
    </div>

    <div class="container border border-dark">
        <div class="row">
            <div class="col-6 border border-dark">
                <b>Código: </b>@Model.Cliente.Id_Cliente<br>
                <b>Cliente: </b>@Model.Cliente.Nombres @Model.Cliente.Apellidos<br>
                <b>Teléfono: </b>@Model.Cliente.Numero_Telefono<br>
                <b>Vendedor: </b>@Model.VendedorNombre<br>
            </div>

            <div class="col-6 border border-dark">
                <b>Factura No.: P @Model.Factura.NumeroFactura</b><br>
                <b>Tipo de factura: </b> @Model.Factura.TipoFactura<br>
                <b>Tipo de pago: </b> @Model.Factura.TipoPago<br>
                <b>Fecha: </b> @Model.Factura.FechaRegistro<br>
                <b>NCF: </b>@Model.Factura.NcfNumero
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row text-center">
            <b>
                DETALLES DE FACTURA
            </b>
        </div>

        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">COD.</th>
                        <th scope="col">DESCRIPCIÓN</th>
                        <th scope="col">CANT.</th>
                        <th scope="col">PRECIO</th>
                        <th scope="col">SUBTOTAL</th>
                        <th scope="col">DESC</th>
                        <th scope="col">TOTAL</th>
                    </tr>
                </thead>

                <tbody>
                    @{
                        foreach (var item in Model.FacturaReporte)
                        {
                            <tr>
                                <td>---</td>
                                <td>@item.PRODUCTO</td>
                                <td>@item.CANTIDAD_PROD.ToString("N0")</td>
                                <td>@item.PRECIO_PROD.ToString("N2")</td>
                                <td>@item.SUBTOTAL_PROD.ToString("N2")</td>
                                <td>@item.DESCUENTO_PROD.ToString("N2")</td>
                                <td>@item.TOTAL_PROD.ToString("N2")</td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="container text-right">
        <div>Subtotal: <b> @Model.Factura.DetalleFacturaList.Sum(x=>x.SubTotal).ToString("N2")</b></div>
        <div>Descuento:<b> @Model.Factura.DetalleFacturaList.Sum(x=>x.Descuento).ToString("N2")</b></div>
        <div>ITBIS:    <b> @Model.Factura.DetalleFacturaList.Sum(x=>x.Itbis).ToString("N2")</b></div>
        <div>Abonado:  <b> @Model.Factura.Abono.ToString("N2")</b></div>
        <div>Total:    <b> @Model.Factura.DetalleFacturaList.Sum(x=>x.Total).ToString("N2")</b></div>
    </div>

    <div class="container">
        <div class="row">
            <p>Nota: FActura Generada</p>
        </div>

        <div class="row">
            <p>
                <b>NOTA: </b>
             @Model.DatosEmpresaFactura.CondicionesGarantia
            </p>
        </div>
    </div>

    <br />
    <br />

    <div class="container">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Entregado por</b>
            </div>

            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>

    <div class="container">
        <div class=" text-right">
            Fecha de Impresión: @Model.Factura.FechaRegistro
        </div>
    </div>
</body>

</html>