@model MVSystemApi.Model.Facturas

@{
    Layout = null;
    // Agrupar por producto y contar la cantidad total de cada uno
    var resumenPorProducto = Model.DetalleFacturaList
        .GroupBy(x => x.Descripcion)
        .Select(g => new
        {
            Producto = g.Key,
            TotalCantidad = g.Sum(x => x.Cantidad)
        }).ToList();

    // Calcular subtotal si no existe en el modelo
    var subtotal = Model.DetalleFacturaList.Sum(x => x.SubTotal);
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />
    <title>Factura</title>
    <style>
        .p0 p {
            padding: 0%;
            margin: 0%;
        }
    </style>
</head>
<body>
    <div class="container text-center">
        <img src="@Model.DatosEmpresaFactura.Logo" alt="Logo Empresa" />
    </div>

    <div class="container text-center p0 mb-3">
        <p>@Model.DatosEmpresaFactura?.Encabezado</p>
        <p>@Model.DatosEmpresaFactura?.Direccion</p>
        <p>@Model.DatosEmpresaFactura?.Telefonos</p>
        <p><b>RNC: @Model.DatosEmpresaFactura?.RNC</b></p>
    </div>

    @{
        var qrUrl = Model.QrUrl;
        string qrBase64 = null;
        if (!string.IsNullOrEmpty(qrUrl))
        {
            var qrGenerator = new QRCoder.QRCodeGenerator();
            var qrData = qrGenerator.CreateQrCode(qrUrl, QRCoder.QRCodeGenerator.ECCLevel.M);
            var qrCode = new QRCoder.PngByteQRCode(qrData);
            var qrBytes = qrCode.GetGraphic(6);
            qrBase64 = Convert.ToBase64String(qrBytes);
        }
    }

    <div class="container border border-dark">
        <div class="row">
            <div class="col-6 border border-dark">
                <p>
                    @{
                        var rnc = Model.Factura?.Rnc ?? Model.RNC;
                        if (!string.IsNullOrEmpty(rnc))
                        {
                            <b>RNC: </b> @rnc
                        }
                        else
                        {
                            <b>Código: </b> @Model.Cliente?.Extencion
                        }
                    }
                </p>
                <b>Cliente: </b>@Model.Factura?.Nombres @Model.Factura?.Apellidos<br>
                <b>Teléfono: </b>@Model.Factura?.Telefono<br>
                <b>Vendedor: </b>@Model.Factura?.Vendedor<br>
            </div>
            <div class="col-6 border border-dark">
                <table style="width:100%; border:none;">
                    <tr>
                        <td style="vertical-align:top; border:none; padding:0;">
                            <b>@Model.Factura?.FacturaTitulo: @Model.Factura?.NumeroFactura</b><br>
                            <b>@Model.Factura?.FacturaTituloTipo:</b> @Model.Factura?.TipoFactura<br>
                            <b>Tipo de pago: </b> @Model.Factura?.TipoPago<br>
                            <b>Fecha: </b> @Model.Factura?.FechaFacturacion.ToString("dd/MM/yyyy")<br>
                            <b>@Model.Factura?.VerNCF</b> @Model.Factura?.Ncf<br>
                        </td>
                    </tr>
                </table>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row text-center mt-4 mb-3">
            <b>DETALLES</b>
        </div>
        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">COD.</th>
                        <th scope="col">DESCRIPCIÓN</th>
                        <th scope="col">CANT.</th>
                        <th scope="col">PRECIO</th>
                        <th scope="col">SUBTOTAL</th>
                        <th scope="col">DESC</th>
                        <th scope="col">TOTAL</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.DetalleFacturaList)
                    {
                        <tr>
                            <td>@item.IdEquipo</td>
                            <td>@item.Descripcion</td>
                            <td>@item.Cantidad.ToString("N0")</td>
                            <td>@item.Precio.ToString("N2")</td>
                            <td>@item.SubTotal.ToString("N2")</td>
                            <td>@item.Descuento.ToString("N2")</td>
                            <td>@item.Total.ToString("N2")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <b>Resumen por modelo:</b>
                <ul>
                    @foreach (var item in resumenPorProducto)
                    {
                        <li>@item.Producto: @item.TotalCantidad</li>
                    }
                </ul>
            </div>
        </div>
    </div>
    <div class="container text-right">
        <div>Subtotal: <b>@Model.Factura?.SubTotal.ToString("N2")</b></div>
        <div>Descuento: <b>@Model.Factura?.Descuento.ToString("N2")</b></div>
        <div>ITBIS: <b>@Model.Factura?.Itbis.ToString("N2")</b></div>
        @if ((Model.Factura?.TipoPago ?? string.Empty).IndexOf("crédito", StringComparison.OrdinalIgnoreCase) >= 0 ||
             (Model.Factura?.TipoPago ?? string.Empty).IndexOf("credito", StringComparison.OrdinalIgnoreCase) >= 0)
        {
            <div>Abonado: <b>@Model.Factura?.Abono.ToString("N2")</b></div>
        }
        <div>Total: <b>@Model.Factura?.Total.ToString("N2")</b></div>
    </div>

    <div class="container">
        <div class="row">
            <p>Nota: @Model.Factura?.Nota</p>
        </div>
        <div class="row">
            <p>
                <b>GARANTIA: </b>
                @Model.DatosEmpresaFactura?.CondicionesGarantia
            </p>
        </div>
    </div>

    <div id="invoice-footer" style="page-break-inside: avoid;">
        <div class="container">
            <div class="row">
                <div class="col-6 text-center">
                    <hr>
                    <b>Entregado por</b>
                </div>
                <div class="col-6 text-center">
                    <hr>
                    <b>Recibido por</b>
                </div>
            </div>
        </div>

        <!-- Sección QR en parte inferior izquierda -->
        @if (qrBase64 != null)
        {
            <div class="container" style="margin-top: 2rem;">
                <div class="row">
                    <div class="col-6">
                        <div style="padding: 0.5rem; width: fit-content;">
                            <img src="data:image/png;base64,@qrBase64" style="width:3.0cm;height:3.0cm; display: block;" />
                            <div style="font-size:8px; margin-top:6px; line-height:1.25;">
                                @if (!string.IsNullOrEmpty(Model.CodigoSeguridad))
                                {
                                    <p style="margin:2px 0;"><b>Código de Seguridad:</b> @Model.CodigoSeguridad</p>
                                }
                                @if (!string.IsNullOrEmpty(Model.FechaFirma))
                                {
                                    <p style="margin:2px 0;"><b>Fecha Firma:</b> @Model.FechaFirma</p>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <div class="container">
            <div class="text-right">
                Fecha de Impresión: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
            </div>
        </div>
    </div>

    <script>
        window.onload = function () {
            var footer = document.getElementById('invoice-footer');
            var pageH = window.innerHeight; // altura real de la página usada por wkhtmltopdf
            var footerH = footer.offsetHeight;
            var footerTop = footer.getBoundingClientRect().top + window.pageYOffset;
            var remainder = footerTop % pageH;
            var gap = pageH - remainder - footerH - 20;
            if (gap > 0) footer.style.marginTop = gap + 'px';
        };
    </script>
</body>
</html>
