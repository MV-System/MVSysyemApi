@using MVSystemApi.Model
@model EmpresaReportes

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Factura</title>

    <style>
        .p0 p {
            padding: 0;
            margin: 0;
        }

        /* Estilos personalizados para ajustar el ancho a 80mm */
        body {
            width: 80mm; /* Establece el ancho del cuerpo a 80mm */
            margin: 0; /* Sin márgenes adicionales */
            font-size: 10pt; /* Ajusta el tamaño de fuente si es necesario */
        }

        /* Ajustar las tablas para que se adapten al ancho de 80mm */
        .table {
            width: 100%;
            font-size: 10pt;
        }

        .container {
            width: 100%;
        }

        .text-right {
            text-align: right;
        }

        .text-center {
            text-align: center;
        }

        /* Elimina márgenes y relleno para asegurarse que todo esté dentro del área de impresión */
        .p0 {
            padding: 0;
            margin: 0;
        }

        /* Bordes del contenedor */
        .border {
            border: 1px solid black;
        }

        .border-dark {
            border-color: black;
        }

        .mb-3 {
            margin-bottom: 1rem;
        }

        .mt-4 {
            margin-top: 1.5rem;
        }

        hr {
            border: 1px solid black;
        }
    </style>
</head>
<body>
    <div class="container border border-dark">
        <div class="row">
            <div class="text-center">
                <img src="@Model.Reparaciones.FirstOrDefault().Logo" alt="Logo Empresa" style="max-width: 150px;" />
                <h2>@Model.Reparaciones.FirstOrDefault().NombreCliente</h2>
                <p>@Model.Reparaciones.FirstOrDefault().ApellidoCliente</p>
            </div>
        </div>
    </div>

    <div class="container">
        <div class="row text-center mt-4 mb-3">
            <b>DETALLES DE RECIBO</b>
        </div>
        <div class="row">
            <table class="table table-bordered">
                <tbody>
                    <tr><th>IMEI:</th><td>@Model.Reparaciones.FirstOrDefault().Imei</td></tr>
                    <tr><th>Detalle:</th><td>@Model.Reparaciones.FirstOrDefault().Detalle_Reparacion</td></tr>
                    <tr><th>Precio:</th><td>@Model.Reparaciones.FirstOrDefault().Precio.ToString("C")</td></tr>
                    <tr><th>Fecha de Entrega:</th><td>@Model.Reparaciones.FirstOrDefault().Fecha_Entrega.ToShortDateString()</td></tr>
                </tbody>
            </table>
        </div>
    </div>
    <div class="container">
        <div class="row">
            @*  <p>
                <b>GARANTIA: </b>
                @Model.DatosEmpresaFactura.CondicionesGarantia
            </p> *@
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Entregado por</b>
            </div>

            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>

    <div class="container text-right">
        Fecha de Impresión: @DateTime.Now
    </div>
</body>
</html>