@using MVSystemApi.Model
@model EmpresaReportes

@{
    Layout = null;
    var c = Model.ComprobanteCustodia;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Comprobante de custodia</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html, body {
            width: 80mm;
            max-width: 80mm;
            margin: 0;
            font-size: 10pt;
            background: #fff;
            overflow-x: hidden;
        }

        .container.text-center p {
            margin-top: 2px;
            margin-bottom: 2px;
        }

        .container {
            width: 100%;
            max-width: 80mm;
            padding: 0 4px;
        }

        .row {
            margin-left: 0 !important;
            margin-right: 0 !important;
        }

        .row > [class^="col-"],
        .row > [class*=" col-"] {
            padding-left: 2px !important;
            padding-right: 2px !important;
        }

        table {
            width: 100% !important;
            max-width: 100%;
            table-layout: fixed;
        }

        th, td {
            word-wrap: break-word;
            overflow-wrap: break-word;
            word-break: break-word;
        }

        .logo {
            display: block;
            margin: 0 auto 8px auto;
            max-width: 120px;
        }

        .section-title {
            font-size: 1.1em;
            font-weight: bold;
            margin: 10px 0 6px 0;
            text-align: center;
            letter-spacing: 1px;
        }

        .table th, .table td {
            padding: 2px 6px;
        }

        .table th {
            width: 38%;
        }

        .limite {
            font-weight: bold;
            font-size: 1.05em;
            border: 2px solid #000;
            padding: 4px;
            text-align: center;
            margin: 6px 0;
        }

        .firma {
            margin-top: 28px;
        }

        body, table, th, td, p, span, b {
            color: #000 !important;
            opacity: 1 !important;
            font-family: Arial, Helvetica, sans-serif !important;
        }
    </style>
</head>
<body>
    <img src="@Model.DatosEmpresaFactura.Logo" alt="Logo" class="logo" />

    <div class="container text-center p0 mb-1">
        <p>@Model.DatosEmpresaFactura.Encabezado</p>
        <p>@Model.DatosEmpresaFactura.Direccion</p>
        <p>@Model.DatosEmpresaFactura.Telefonos</p>
        <p><b>RNC: @Model.DatosEmpresaFactura.RNC</b></p>
    </div>

    <div class="section-title">*** COMPROBANTE DE CUSTODIA ***</div>

    <div class="container border border-dark mb-2">
        <div class="text-center"><b>Cambio de pieza # @c.IdCambio</b></div>
        <div class="text-center"><b>Fecha: </b>@c.FechaRegistro.ToString("dd/MM/yyyy hh:mm tt")</div>
    </div>

    <div class="container">
        <table class="table table-bordered table-sm">
            <tbody>
                <tr>
                    <th>Laptop:</th>
                    <td>@c.Marca @c.Modelo</td>
                </tr>
                <tr>
                    <th>Serial:</th>
                    <td>@c.Imei</td>
                </tr>
                <tr>
                    <th>Pieza retirada:</th>
                    <td>@c.TipoPieza · @c.PiezaRetirada@(string.IsNullOrEmpty(c.ModeloRetirada) ? "" : " (" + c.ModeloRetirada + ")")</td>
                </tr>
                @if (!string.IsNullOrEmpty(c.PiezaInstalada))
                {
                    <tr>
                        <th>Pieza instalada:</th>
                        <td>@c.PiezaInstalada@(string.IsNullOrEmpty(c.ModeloInstalada) ? "" : " (" + c.ModeloInstalada + ")")</td>
                    </tr>
                }
                @if (!string.IsNullOrEmpty(c.ConfigNueva))
                {
                    <tr>
                        <th>Configuración:</th>
                        <td>@c.ConfigAnterior → @c.ConfigNueva</td>
                    </tr>
                }
                <tr>
                    <th>Técnico:</th>
                    <td>@(string.IsNullOrWhiteSpace(c.TecnicoNombre) ? c.Tecnico : c.TecnicoNombre)</td>
                </tr>
                <tr>
                    <th>Registrado por:</th>
                    <td>@c.UsuarioRegistro</td>
                </tr>
                @if (!string.IsNullOrEmpty(c.Almacen))
                {
                    <tr>
                        <th>Almacén:</th>
                        <td>@c.Almacen</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="container">
        <div class="limite">
            Debe entregarse antes de:<br />
            @c.FechaLimite.ToString("dd/MM/yyyy hh:mm tt")
        </div>
        <div class="text-center" style="font-size: 9pt;">
            La pieza queda en custodia del técnico (@c.HorasMax horas máximo) hasta que otro usuario confirme su recepción.
        </div>
    </div>

    <div class="container firma">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Firma del técnico</b>
            </div>
            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>
</body>
</html>
