@model MVSystemApi.Model.FacturaConsultaReporteViewModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="/assets/bootstrap.min.css" rel="stylesheet" />
    <title>Facturas</title>
    <style>
        .p0 p {
            padding: 0%;
            margin: 0%;
        }

        .margenes {
            margin-top: 30px;
            margin-bottom: 0px;
        }
    </style>
</head>
<body class="margenes">
    <div class="container text-center">
        <img src="@Model.DatosEmpresaFactura.Logo" alt="Logo" />
    </div>
    <div class="container text-center p0 mb-3">
        <p>@Model.DatosEmpresaFactura?.Encabezado</p>
        <p>@Model.DatosEmpresaFactura?.Direccion</p>
        <p>@Model.DatosEmpresaFactura?.Telefonos</p>
        <p><b>RNC: @Model.DatosEmpresaFactura?.RNC</b></p>
    </div>
    <div class="container ">
        <div class="row text-center">
            <b>LISTA DE FACTURAS</b>
        </div>
        <div class="row margenes">
            <table class="table table-bordered">
                <thead>
                    <tr>
                        <th scope="col">Fac.</th>
                        <th scope="col">Cliente</th>
                        <th scope="col">tipo fac..</th>
                        <th scope="col">pago</th>
                        <th scope="col">SubTotal</th>
                        <th scope="col">Descuento</th>
                        <th scope="col">total</th>
                        <th scope="col">fecha</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var factura in Model.Facturas)
                    {
                        <tr>
                            <td>@factura.NumeroFactura</td>
                            <td>@factura.Nombres @factura.Apellidos</td>
                            <td>@factura.TipoFactura</td>
                            <td>@factura.TipoPago</td>
                            <td>@factura.SubTotal</td>
                            <td>@factura.Descuento</td>
                            <td>@factura.Total</td>
                            <td>@factura.FechaFacturacion</td>
                        </tr>
                    }
                    <tr class="notBorder">
                        <td></td>
                        <td></td>
                        <td></td>
                        <td></td>
                        <td><b>@Model.Facturas.Sum(x => x.SubTotal).ToString("N2")</b></td>
                        <td><b>@Model.Facturas.Sum(x => x.Descuento).ToString("N2")</b></td>
                        <td><b>@Model.Facturas.Sum(x => x.Total).ToString("N2")</b></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
    <br />
    <br />
    <div class="container">
        <div class="row">
            <div class="col-6 text-center"><hr><b>Entregado por</b></div>
            <div class="col-6 text-center"><hr><b>Recibido por</b></div>
        </div>
    </div>
    <div class="container">
        <div class="text-right">
            Fecha de Impresión: @DateTime.Now
        </div>
    </div>
</body>
</html>
