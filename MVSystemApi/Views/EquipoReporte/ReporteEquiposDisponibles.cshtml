@model MVSystemApi.Model.EmpresaReportes

@{
    Layout = null;
    // Cada registro representa un equipo; agrupar por descripción y contar
    // equivale a sumar la cantidad de cada producto en el PDF de factura.
    var resumenPorModelo = Model.EquiposDTO
        .GroupBy(x => x.Descripcion)
        .Select(g => new
        {
            Modelo = g.Key,
            TotalCantidad = g.Count()
        }).ToList();
}

<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link href="~/assets/bootstrap.min.css" rel="stylesheet" />

    <title>Detalle Equipos Disponibles</title>

    <style>
        .p0 p {
            padding: 0%;
            margin: 0%;
        }
    </style>
</head>

<body>
    <div class="container text-center">
        <img src="@Model.EquiposDTO.FirstOrDefault()?.logo" alt="Logo" />
    </div>

    <div class="container text-center p0">
        <p>@Model.DatosEmpresaFactura.Encabezado</p>
        <p>@Model.DatosEmpresaFactura.Direccion</p>
        <p>@Model.DatosEmpresaFactura.Telefonos</p>
        <p> <b>RNC: @Model.DatosEmpresaFactura.RNC</b> </p>
    </div>
     <div  class="container text-center">
        <h1><b> REPORTE DE EQUIPOS DISPONIBLES</b></h1>
    </div>

    <div class="container mt-5">

        <hr />
        <div class="row">
            <table class="table table-bordered">
                <thead>
                    <tr>

                        <th scope="col">IMEI</th>
                        <th scope="col">DESCRIPCIÓN</th>
                        <th scope="col">P POR MAYOR</th>
                        <th scope="col">P DETALLE</th>
                        <th scope="col">DESBLOQ</th>
                        <th scope="col">ALMACEN</th>
                        <th scope="col">SUPLIDOR</th>
                        <th scope="col">COMISION DETALLE</th>
                        <th scope="col">COMISION POR MAYOR</th>
                    </tr>
                </thead>

                <tbody>

                    @{
                        foreach (var item in Model.EquiposDTO)
                        {

                                    <tr>
                                        <td>@item.Imei</td>
                                        <td>@item.Descripcion</td>
                                        <td>@item.PrecioPorMayor.ToString("N2")</td>
                                        <td>@item.PrecioDetalle.ToString("N2")</td>
                                        <td>@item.IsDesbloqueado</td>
                                        <td>@item.DescripcionAlmacen</td>
                                        <td>@item.Suplidor</td>
                                        <td>@item.ComisionDetalle</td>
                                        <td>@item.ComisionPorMayor</td>
                                    </tr>

                        }
                    }
                </tbody>
            </table>
        </div>
    </div>

    <div class="container">
        <div class="row">
            <div class="col-12">
                <b>Resumen por modelo:</b>
                <ul>
                    @foreach (var item in resumenPorModelo)
                    {
                        <li>@item.Modelo: @item.TotalCantidad</li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="container text-right">

        <div><b>TOTAL EQUIPOS: @Model.EquiposDTO.Count()</b></div>
    </div>

    <div class="container">
        <div class="row">
            <p>Nota:</p>
        </div>

    </div>

    <br />
    <br />

    <div class="container">
        <div class="row">
            <div class="col-6 text-center">
                <hr>
                <b>Entregado por</b>
            </div>

            <div class="col-6 text-center">
                <hr>
                <b>Recibido por</b>
            </div>
        </div>
    </div>

    <div class="container">
        <div class=" text-right">
            Fecha de Impresión:
            @DateTime.Now
        </div>
    </div>
</body>

</html>